FLASK_ENV=development
PORT=5000
LOG_LEVEL=INFO

# LLM provider: gemini|openai|anthropic
PRIMARY_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# For Azure OpenAI (optional):
OPENAI_API_BASE=
OPENAI_API_VERSION=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Debug (never enable in production)
DEBUG_LOG_PAYLOAD=false
DEBUG_LOG_PAYLOAD_MAX_CHARS=20000

# Cache / DB
USE_DB_CACHE=true
DB_HOST=127.0.0.1
# If using SSH port-forwarding, set DB_PORT to your LOCAL forwarded port (example: 23306)
DB_PORT=23306
DB_USER=
DB_PASSWORD=
DB_NAME=pcori_dashboard
PATIENT_TABLE=patient_data
STORY_CACHE_TABLE=story_cache
